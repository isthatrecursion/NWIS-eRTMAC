NWIS_ENV=development
NWIS_DEMO_MODE=false
NWIS_SERVE_FRONTEND=false
NWIS_DATABASE_URL=postgresql+psycopg://nwis:nwis@localhost:5432/nwis
NWIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://127.0.0.1:8000
# Replay configuration accepts JSON; unspecified channels default to 30 seconds.
NWIS_CHANNEL_FRESHNESS_S={"mud_weight_sg":60,"gas_pct":15,"flow_in_l_min":30,"flow_out_l_min":30}
NWIS_MUD_LOSS_POLICY={"lesson_distance_m":300,"approach_distance_m":100,"flow_deficit_min_l_min":30,"flow_deficit_fraction":0.05,"flow_sustained_min_samples":3,"flow_sustained_min_s":20,"pit_drop_min_m3":0.5,"trend_min_s":30,"trend_max_s":120,"acquisition_gap_max_s":30,"sample_skew_max_s":10}
NWIS_HISTORICAL_POLICY={"minimum_weight":0.08,"elevated_min_support":2,"elevated_min_n_eff":3,"elevated_min_p_hat":0.45,"alpha":1,"beta":1}
